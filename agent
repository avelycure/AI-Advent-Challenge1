#!/usr/bin/env bash
# Точка входа агента. Названа коротко, чтобы её было удобно положить в PATH
# и вызывать из любого каталога, как привычный терминальный инструмент:
#
#   ln -s "$(pwd)/agent" ~/.local/bin/agent
#
# Каждый запуск — своя сессия со своей памятью. Окружение готовится один раз.
set -euo pipefail

# Скрипт задуман для запуска через симлинк из PATH, поэтому свой каталог он
# должен искать по настоящему файлу, а не по ссылке: иначе окружение создаётся
# рядом с симлинком, а зависимости ищутся в ~/.local/bin.
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  TARGET="$(readlink "$SOURCE")"
  case "$TARGET" in
    /*) SOURCE="$TARGET" ;;
    *)  SOURCE="$(cd -P "$(dirname "$SOURCE")" && pwd)/$TARGET" ;;
  esac
done
HERE="$(cd -P "$(dirname "$SOURCE")" && pwd)"
VENV="$HERE/.venv"
PYTHON="${PYTHON:-python3}"

if [ ! -d "$VENV" ]; then
  echo "→ Создаю виртуальное окружение…" >&2
  "$PYTHON" -m venv "$VENV"
fi

if [ ! -f "$VENV/.deps-ok" ]; then
  echo "→ Ставлю зависимости…" >&2
  "$VENV/bin/python" -m pip install --upgrade pip -q
  "$VENV/bin/pip" install -q -r "$HERE/requirements.txt"
  "$VENV/bin/pip" install -q tiktoken 2>/dev/null || true
  touch "$VENV/.deps-ok"
fi

exec "$VENV/bin/python" "$HERE/chat.py" "$@"
